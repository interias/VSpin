# Replay-Fixtures werden byteweise mit der Roh-JSONL der Bridge verglichen (ADR-0008):
# immer mit LF auschecken, auch bei core.autocrlf=true.
*.jsonl text eol=lf

# Windows-Batchdateien immer mit CRLF auschecken (cmd.exe findet Sprungmarken in LF-Dateien unzuverlässig),
# auch bei core.autocrlf=false oder input.
*.cmd text eol=crlf
