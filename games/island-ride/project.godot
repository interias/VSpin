; Engine configuration file.
; Godot 4.4 – Inselfahrt (Prototyp-Game, ADR-0005).

config_version=5

[application]

config/name="Inselfahrt"
config/description="3D-Radsimulator am VSPIN-Bus: Kadenz -> Geschwindigkeit."
